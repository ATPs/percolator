#!/usr/bin/env bash
# Fully static Linux build using the locally installed GCC 14 and Conda sysroot.
set -e
if [[ -f /opt/rh/gcc-toolset-14/enable ]]; then
  source /opt/rh/gcc-toolset-14/enable
fi
set -u
SRC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUILD_DIR="${BUILD_DIR:-${SRC_DIR}/build/static-gcc14}"
CONDA_ROOT="${CONDA_PREFIX:-/data/p/anaconda3}"
STATIC_SYSROOT="${STATIC_SYSROOT:-${CONDA_ROOT}/x86_64-conda-linux-gnu/sysroot}"
STATIC_ZLIB_ROOT="${STATIC_ZLIB_ROOT:-/data/p/hdf5/zlib-1.2.11_build_gcc13_glibc217}"
INSTALL_PREFIX="${INSTALL_PREFIX:-${SRC_DIR}/bin-static}"
JOBS="${JOBS:-12}"
extra_args=()
if [[ -d "${SRC_DIR}/build-noxml/_deps/googletest-src" ]]; then
  extra_args+=("-DFETCHCONTENT_SOURCE_DIR_GOOGLETEST=${SRC_DIR}/build-noxml/_deps/googletest-src")
fi
cmake -S "${SRC_DIR}" -B "${BUILD_DIR}" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_CXX_COMPILER="$(command -v g++)" \
  -DCMAKE_SYSROOT="${STATIC_SYSROOT}" \
  -DCMAKE_EXE_LINKER_FLAGS=-static \
  -DCMAKE_INSTALL_PREFIX="${INSTALL_PREFIX}" \
  -DSTATIC=ON -DUSE_SYSTEM_GTEST=OFF \
  -DZLIB_LIBRARY="${STATIC_ZLIB_ROOT}/lib/libz.a" \
  -DZLIB_INCLUDE_DIR="${STATIC_ZLIB_ROOT}/include" \
  "${extra_args[@]}"
cmake --build "${BUILD_DIR}" -j "${JOBS}"
ctest --test-dir "${BUILD_DIR}" --output-on-failure -j 2
cmake --install "${BUILD_DIR}"
cmake --build "${BUILD_DIR}" --target test-install
file "${INSTALL_PREFIX}/bin/percolator" "${INSTALL_PREFIX}/bin/qvality"
